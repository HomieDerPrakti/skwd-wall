settings-integrations-plasma-card = KDE Plasma
settings-integrations-plasma-card-desc = skwd-wall کو Plasma ڈیسک ٹاپ سے جوڑیں۔ لاک اسکرین وال پیپر کے اختیارات نیچے ترتیب دیے جاتے ہیں۔
settings-integrations-lock-mode-label = لاک اسکرین وال پیپر
settings-integrations-lock-mode-desc = غیر منظم Plasma کو چھیڑتا نہیں۔ ساکن ہمیشہ نیچے دی گئی تصویر استعمال کرتا ہے۔ پیروی سب سے آخر میں لاگو کیے گئے وال پیپر کے ساتھ چلتا ہے۔
settings-integrations-lock-off = غیر منظم
settings-integrations-lock-static = ساکن تصویر
settings-integrations-lock-follow = آخری لاگو کردہ کی پیروی
settings-integrations-lock-image-label = تصویر
settings-integrations-lock-image-desc = مکمل راستہ، یا ~/ سے شروع ہونے والا راستہ۔ Plasma کا بلٹ ان تصویری وال پیپر اسے لاک اسکرین پر دکھاتا ہے۔
settings-integrations-lock-dynamic-label = ویڈیوز اور مناظر
settings-integrations-lock-dynamic-desc = پوسٹر فریم بغیر ڈیکوڈر کے ایک خاموش تصویر دکھاتا ہے۔ لائیو ویڈیوز اور مناظر چلاتا ہے، ہر لاک شدہ ڈسپلے کے لیے ایک رینڈرر کے ساتھ۔
settings-integrations-lock-poster = پوسٹر فریم
settings-integrations-lock-live = لائیو (تجرباتی)
settings-integrations-noctalia-card = Noctalia
settings-integrations-noctalia-card-desc = یہ اختیارات اس وقت استعمال کریں جب Noctalia رنگ بناتا ہے یا Skwd سے رنگ اسکیم وصول کرتا ہے۔
settings-integrations-noctalia-mode-label = Noctalia تھیم موڈ
settings-integrations-noctalia-mode-desc = ہر رنگ اسکیم کے ساتھ یہ موڈ لاگو کریں۔ Skwd کی پیروی Skwd کا طے شدہ ہلکا یا تاریک موڈ استعمال کرتی ہے؛ Noctalia کا شیڈول اس کی طلوع اور غروب آفتاب کی ترتیبات استعمال کرتا ہے۔ برقرار رکھیں Noctalia کا موجودہ انتخاب نہیں بدلتا۔ بار اور پینل صرف تب پیروی کرتے ہیں جب Noctalia کا شیل موڈ تھیم موڈ کی پیروی کرے۔ ہوور پیش منظر موجودہ موڈ برقرار رکھتے ہیں۔
settings-integrations-noctalia-mode-follow = Skwd کی پیروی
settings-integrations-noctalia-mode-keep = Noctalia کا موڈ برقرار رکھیں
settings-integrations-noctalia-mode-dark = تاریک
settings-integrations-noctalia-mode-light = ہلکا
settings-integrations-noctalia-mode-auto = Noctalia کا شیڈول
settings-integrations-noctalia-hover-label = Noctalia میں ہوور رنگ پیش منظر
settings-integrations-noctalia-hover-desc = وال پیپر پر ہوور کرنے سے Noctalia کی بار، پینل اور ٹیمپلیٹس کے رنگ عارضی طور پر بدل جاتے ہیں۔ ہوور ختم ہونے پر محفوظ اسکیم واپس آ جاتی ہے۔
settings-integrations-noctalia-bin-label = Noctalia بائنری
settings-integrations-noctalia-bin-desc = noctalia بائنری کا راستہ اگر یہ PATH میں نہ ہو۔
settings-integrations-dms-card = Dank Material Shell
settings-integrations-dms-card-desc = Skwd کے رنگ وصول کرنے کے لیے DMS کو Auto (wallpaper) استعمال کرنا ہوگا۔
settings-integrations-dms-hover-label = DMS میں ہوور رنگ پیش منظر
settings-integrations-dms-hover-desc = وال پیپر پر ہوور کرنے سے dms-colors.json عارضی طور پر دوبارہ لکھی جاتی ہے۔ ہوور ختم ہونے پر اصل رنگ واپس آ جاتے ہیں۔

settings-integrations-follow-label = Skwd کے رنگوں کی پیروی
settings-integrations-follow-desc = جب Skwd رنگ کنٹرول کرے تو اس کی پیروی کریں۔ بند ہونے پر موجودہ رنگ برقرار رہتے ہیں۔
