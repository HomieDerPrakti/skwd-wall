settings-integrations-plasma-card = KDE Plasma
settings-integrations-plasma-card-desc = skwd-wall-কে Plasma ডেস্কটপের সাথে যুক্ত করুন। লক স্ক্রিন ওয়ালপেপারের বিকল্প নিচে কনফিগার করা হয়।
settings-integrations-lock-mode-label = লক স্ক্রিন ওয়ালপেপার
settings-integrations-lock-mode-desc = অব্যবস্থাপিত Plasma-কে যেমন আছে তেমন রাখে। স্থির সবসময় নিচের ছবি ব্যবহার করে। অনুসরণ সর্বশেষ প্রয়োগ করা ওয়ালপেপার অনুসরণ করে।
settings-integrations-lock-off = অব্যবস্থাপিত
settings-integrations-lock-static = স্থির ছবি
settings-integrations-lock-follow = সর্বশেষ প্রয়োগ করাটি অনুসরণ করুন
settings-integrations-lock-image-label = ছবি
settings-integrations-lock-image-desc = পরম পথ, বা ~/ দিয়ে শুরু হওয়া পথ। Plasma-র অন্তর্নির্মিত ছবি ওয়ালপেপার এটি লক স্ক্রিনে দেখায়।
settings-integrations-lock-dynamic-label = ভিডিও ও দৃশ্য
settings-integrations-lock-dynamic-desc = পোস্টার ফ্রেম ডিকোডার ছাড়াই একটি নিঃশব্দ ছবি দেখায়। লাইভ ভিডিও ও দৃশ্য চালায়, প্রতিটি লক করা ডিসপ্লের জন্য একটি রেন্ডারার সহ।
settings-integrations-lock-poster = পোস্টার ফ্রেম
settings-integrations-lock-live = লাইভ (পরীক্ষামূলক)
settings-integrations-noctalia-card = Noctalia
settings-integrations-noctalia-card-desc = Noctalia রং তৈরি করলে বা Skwd থেকে রঙের স্কিম পেলে এই বিকল্পগুলো ব্যবহার করুন।
settings-integrations-noctalia-mode-label = Noctalia থিম মোড
settings-integrations-noctalia-mode-desc = প্রতিটি রঙের স্কিমের সাথে এই মোড প্রয়োগ করে। Skwd অনুসরণ Skwd-এর নির্ধারিত হালকা বা গাঢ় মোড ব্যবহার করে; Noctalia-র সময়সূচি এর সূর্যোদয় ও সূর্যাস্তের সেটিংস ব্যবহার করে। রাখুন Noctalia-র বর্তমান পছন্দ অপরিবর্তিত রাখে। Noctalia-র শেল মোড থিম মোড অনুসরণ করলে তবেই বার ও প্যানেল অনুসরণ করে। হোভার প্রিভিউ বর্তমান মোড বজায় রাখে।
settings-integrations-noctalia-mode-follow = Skwd অনুসরণ করুন
settings-integrations-noctalia-mode-keep = Noctalia-র মোড রাখুন
settings-integrations-noctalia-mode-dark = গাঢ়
settings-integrations-noctalia-mode-light = হালকা
settings-integrations-noctalia-mode-auto = Noctalia-র সময়সূচি
settings-integrations-noctalia-hover-label = Noctalia-তে হোভার রঙের প্রিভিউ
settings-integrations-noctalia-hover-desc = ওয়ালপেপারে হোভার করলে Noctalia-র বার, প্যানেল ও টেমপ্লেটের রং সাময়িকভাবে বদলায়। হোভার শেষ হলে সংরক্ষিত স্কিম ফিরে আসে।
settings-integrations-noctalia-bin-label = Noctalia বাইনারি
settings-integrations-noctalia-bin-desc = noctalia বাইনারি PATH-এ না থাকলে তার পথ।
settings-integrations-dms-card = Dank Material Shell
settings-integrations-dms-card-desc = Skwd-এর রং পেতে DMS-কে Auto (wallpaper) ব্যবহার করতে হবে।
settings-integrations-dms-hover-label = DMS-এ হোভার রঙের প্রিভিউ
settings-integrations-dms-hover-desc = ওয়ালপেপারে হোভার করলে dms-colors.json সাময়িকভাবে পুনর্লিখিত হয়। হোভার শেষ হলে মূল রং ফিরে আসে।

settings-integrations-follow-label = Skwd-এর রং অনুসরণ করুন
settings-integrations-follow-desc = Skwd রং নিয়ন্ত্রণ করার সময় তাকে অনুসরণ করে। বন্ধ থাকলে বর্তমান রং বজায় থাকে।
